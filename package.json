{
  "name": "gosetup",
  "module": "src/index.tsx",
  "version": "0.1.0",
  "description": "TUI for scaffolding Go backend projects",
  "author": "divin3circle",
  "license": "MIT",
  "homepage": "https://github.com/divin3circle/gosetup",
  "repository": {
    "type": "git",
    "url": "https://github.com/divin3circle/gosetup.git"
  },
  "bin": {
    "gosetup": "./bin/gosetup"
  },
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.tsx",
    "build": "bun build src/index.tsx --compile --outfile ./bin/gosetup && chmod +x ./bin/gosetup --minify",
    "prepublishOnly": "bun run build"
  },
  "files": [
    "bin",
    "src",
    "package.json",
    "README.md"
  ],
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@opentui/core": "^0.1.69",
    "@opentui/react": "^0.1.69",
    "react": "^19.2.3"
  }
}
